+IOReturn
+PolarisKeys::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+	PolarisKeys *self = OSDynamicCast(PolarisKeys, owner);
+	if (self == NULL) return kIOReturnBadArgument;
+	self->fEnabled = false;
+	if (self->fTimer != NULL) {
+		self->fTimer->cancelTimeout();
+		self->fTimer->disable();
+	}
+	self->disableLane(true);
+	self->disableLane(false);
+	return kIOReturnSuccess;
+}
