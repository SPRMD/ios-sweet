 void
+PolarisKeys::disableLane(bool pon)
+{
+	bool *usable = pon ? &fPONUsable : &fGPIOUsable;
+	if (!*usable) return;
+	*usable = false;
+	/* Fail the whole lane closed on an ambiguous read. Pair any down event
+	 * once, then suppress further events on this lane until service restart. */
+	for (unsigned key = 0; key < 3; ++key) {
+		if ((key != 1) != pon) continue;
+		if (fDown[key]) {
+			fDown[key] = false;
+			sweet_hid_key((int)key, 0);
+		}
+		fLive[key] = false;
+		fCandidateValid[key] = false;
+	}
+}
