diff --git a/bsd/dev/polaris_gpu_diag.c b/bsd/dev/polaris_gpu_diag.c
--- a/bsd/dev/polaris_gpu_diag.c
+++ b/bsd/dev/polaris_gpu_diag.c
@@ -96,7 +96,13 @@ polaris_gpu_diag(void)
 			return;
 		}
 		reserve = (size + GPU_PAGE - 1u) & ~(GPU_PAGE - 1u);
