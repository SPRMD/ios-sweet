+#if !defined(POLARIS_DRIVER_HOST_TEST)
+/* Both SOC copies must agree. Zero is a valid measurement, not an error. */
+static bool
+polarisSocPercent(uint16_t raw, unsigned *percent)
+{
+	if (percent == NULL) {
+		return false;
+	}
+	const uint8_t primary = (uint8_t)(raw & 0xffU);
+	const uint8_t shadow = (uint8_t)(raw >> 8);
+	if (primary != shadow) {
+		return false;
+	}
+	*percent = ((unsigned)primary * 100U + 127U) / 255U;
+	return true;
+}
+#endif
 
