+
+/* MiCode's fg_get_msoc mapping with report_full=false: reserve the two
+ * endpoints for raw 0 and 255. report_full needs charger state and is not
+ * inferred here. */
+static inline unsigned conservativeSocPercent(uint8_t raw)
+{
+	if (raw == 0) return 0;
+	if (raw == 255) return 100;
+	return (((unsigned)raw - 1U) * 98U + 126U) / 253U + 1U;
+}
 
