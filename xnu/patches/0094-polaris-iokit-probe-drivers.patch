+bool
+PolarisBluetooth::start(IOService *provider)
+{
+	if (!IOService::start(provider) || !PolarisDriver::boardMatches()) {
+		return false;
+	}
+	IORegistryEntry *slim = PolarisDriver::nodeAt("/soc/slim@17240000/wcn3990");
+	IORegistryEntry *vendor = PolarisDriver::nodeAt("/vendor/bt_wcn3990");
+	if (slim == NULL && vendor == NULL) {
+		IOLog("POLARIS BT: WCN3990 SlimBus nodes absent; service withheld\n");
+		OSSafeReleaseNULL(slim);
+		OSSafeReleaseNULL(vendor);
+		return false;
+	}
+	PolarisDriver::ResourceRange ranges[2] = {};
+	unsigned rangeCount = slim != NULL ? PolarisDriver::readRanges(slim, ranges, 2) : 0;
+	PolarisDriver::publishCommon(this, "Bluetooth", "probe-only", false);
+	PolarisDriver::publishString(this, "ChipFamily", "Qualcomm WCN3990");
+	PolarisDriver::publishString(this, "Transport", "SlimBus btfmslim_slave");
+	PolarisDriver::publishString(this, "FirmwareSet", "apbtfw10.tlv,apbtfw11.tlv,crbtfw11.tlv,crbtfw20.tlv,crbtfw21.tlv,apnv*.bin,crnv*.bin");
+	PolarisDriver::publishString(this, "BlueToolCompatibility", "not assumed; Apple BlueTool protocol is not a WCN3990 driver");
+	PolarisDriver::publishNumber(this, "SlimBusResourceCount", rangeCount);
+	PolarisDriver::publishNumber(this, "VendorNodePresent", vendor != NULL ? 1 : 0);
+	setName("PolarisBluetooth");
+	registerService();
+	IOLog("POLARIS BT: IOKit probe registered; SlimBus resources=%u, writes disabled\n", rangeCount);
+	OSSafeReleaseNULL(slim);
+	OSSafeReleaseNULL(vendor);
+	return true;
+}
+
+extern "C" bool
+PolarisBluetoothStart(IOService *provider)
