diff --git a/iokit/Kernel/arm/PolarisCamera.cpp b/iokit/Kernel/arm/PolarisCamera.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/PolarisCamera.cpp
@@ -0,0 +1,65 @@
+#include "PolarisDriverSupport.h"
+
+#if defined(SWEET) || defined(POLARIS_DRIVER_HOST_TEST)
+class PolarisCamera : public IOService
+{
+	OSDeclareDefaultStructors(PolarisCamera);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(PolarisCamera, IOService);
+
+bool
+PolarisCamera::start(IOService *provider)
+{
+	static const char *const sensors[] = {
+		"/soc/qcom,cci@ac4a000/qcom,cam-sensor@0",
+		"/soc/qcom,cci@ac4a000/qcom,cam-sensor@1",
+		"/soc/qcom,cci@ac4a000/qcom,cam-sensor@2",
+	};
+	if (!IOService::start(provider) || !PolarisDriver::boardMatches()) {
+		return false;
+	}
+	unsigned sensorCount = 0;
+	for (unsigned i = 0; i < sizeof(sensors) / sizeof(sensors[0]); ++i) {
+		IORegistryEntry *sensor = PolarisDriver::nodeAt(sensors[i]);
+		if (sensor != NULL) {
+			sensorCount++;
+		}
+		OSSafeReleaseNULL(sensor);
+	}
+	IORegistryEntry *cci = PolarisDriver::nodeAt("/soc/qcom,cci@ac4a000");
+	IORegistryEntry *csiphy = PolarisDriver::nodeAt("/soc/qcom,csiphy@ac65000");
+	IORegistryEntry *csid = PolarisDriver::nodeAt("/soc/qcom,csid0@acb3000");
+	if (sensorCount == 0 && cci == NULL && csiphy == NULL && csid == NULL) {
+		IOLog("POLARIS CAMERA: CCI/CSIPHY/CSID nodes absent; service withheld\n");
+		OSSafeReleaseNULL(cci);
+		OSSafeReleaseNULL(csiphy);
+		OSSafeReleaseNULL(csid);
+		return false;
+	}
+	PolarisDriver::publishCommon(this, "Camera", "probe-only", false);
+	PolarisDriver::publishString(this, "SensorModules", "imx363,ov5675,s5k3m3");
+	PolarisDriver::publishString(this, "SensorOrder", "unknown until per-device EEPROM/DT overlay is confirmed");
+	PolarisDriver::publishString(this, "Pipeline", "CCI -> CSIPHY -> CSID; ISP/IFE and SMMU backend not implemented");
+	PolarisDriver::publishNumber(this, "SensorNodeCount", sensorCount);
+	PolarisDriver::publishNumber(this, "CCIPresent", cci != NULL ? 1 : 0);
+	PolarisDriver::publishNumber(this, "CSIPHYPresent", csiphy != NULL ? 1 : 0);
+	PolarisDriver::publishNumber(this, "CSIDPresent", csid != NULL ? 1 : 0);
+	setName("PolarisCamera");
+	registerService();
+	IOLog("POLARIS CAMERA: IOKit probe registered; sensors=%u, writes disabled\n", sensorCount);
+	OSSafeReleaseNULL(cci);
+	OSSafeReleaseNULL(csiphy);
+	OSSafeReleaseNULL(csid);
+	return true;
+}
+
+extern "C" bool
+PolarisCameraStart(IOService *provider)
+{
+	return PolarisDriver::startProbeService<PolarisCamera>(provider, "CAMERA");
+}
+#endif
diff --git a/iokit/Kernel/arm/PolarisDrivers.cpp b/iokit/Kernel/arm/PolarisDrivers.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/PolarisDrivers.cpp
@@ -0,0 +1,22 @@
+#include "PolarisDriverSupport.h"
+
+#if defined(SWEET) || defined(POLARIS_DRIVER_HOST_TEST)
+extern "C" bool PolarisGPUStart(IOService *provider);
+extern "C" bool PolarisWiFiStart(IOService *provider);
+extern "C" bool PolarisBluetoothStart(IOService *provider);
+extern "C" bool PolarisCameraStart(IOService *provider);
+
+extern "C" void
+PolarisDriversStart(IOService *provider)
+{
+	if (provider == NULL || !PolarisDriver::boardMatches()) {
+		return;
+	}
+	IOLog("POLARIS DRIVERS: starting IOKit probe services\n");
+	(void)PolarisGPUStart(provider);
+	(void)PolarisWiFiStart(provider);
+	(void)PolarisBluetoothStart(provider);
+	(void)PolarisCameraStart(provider);
+	IOLog("POLARIS DRIVERS: probe services complete; all hardware writes disabled\n");
+}
+#endif
