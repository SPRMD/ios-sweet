+/* Opt-in, read-only diagnostics. This does not instantiate device drivers. */
+static void PolarisFDTDiagnose(void)
+{
+    if (!PolarisDriver::bootArgEnabled("polarisfdt")) return;
+    DTEntry root = NULL; const void *slot = NULL; unsigned int slotSize = 0;
+    if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+        SecureDTGetProperty(root, "polaris-abl-fdt", &slot, &slotSize) != kSuccess ||
+        slot == NULL || slotSize != PFDT_MAX_SIZE + 4u) {
+        IOLog("POLARIS FDT: transport absent\n"); return;
+    }
+    const uint8_t *p = static_cast<const uint8_t *>(slot);
+    uint32_t n = p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+    struct pfdt_view v; const volatile uint8_t *value; uint32_t len; int found;
+    if (!n || n > PFDT_MAX_SIZE || !pfdt_init(&v, p + 4, n) || v.total != n ||
+        !pfdt_lookup(&v, "/", NULL, &value, &len, &found) || !found) {
+        IOLog("POLARIS FDT: invalid or empty transport\n"); return;
+    }
+    static const char *const paths[] = { "/soc", "/vendor", "/soc/qcom,icnss@18800000" };
+    for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); ++i) {
+        if (!pfdt_lookup(&v, paths[i], NULL, &value, &len, &found)) {
+            IOLog("POLARIS FDT: parse failed\n"); return;
+        }
+        IOLog("POLARIS FDT: %s %s\n", paths[i], found ? "present" : "absent");
+    }
+}
+
 
