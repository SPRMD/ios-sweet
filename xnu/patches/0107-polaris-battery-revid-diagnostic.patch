+++ b/iokit/Kernel/arm/PolarisBatteryRevision.h
@@ -0,0 +1,46 @@
+/*
+ * Read-only PMI8998 revision identification; no MMIO, power or fuel-gauge
+ * sample operations here. The caller owns the transport and lifetime.
+ */
+#pragma once
+#include <stdint.h>
+
+namespace PolarisBatteryRevision {
+enum Kind { Unknown, Early, V2 };
+typedef bool (*Read)(void *context, uint16_t peripheral, uint8_t reg,
+    uint8_t *bytes, unsigned count);
+struct Result { Kind kind; uint8_t rev4; };
+
+/* qcom,qpnp-revid at SID2 / 0x100: digital major, type and subtype.
+ * Two identical reads are required. Recognize only published PMI8998 rev4
+ * values, rather than treating unspecified earlier values as valid. */
+static inline bool identify(Read read, void *context, Result *out)
+{
+	if (out == 0) return false;
+	out->kind = Unknown;
+	out->rev4 = 0;
+	if (read == 0) return false;
+	uint8_t first[3] = {}, second[3] = {};
+	if (!read(context, 0x201, 0x03, first, 3) ||
+	    !read(context, 0x201, 0x03, second, 3)) return false;
+	for (unsigned i = 0; i < 3; ++i)
+		if (first[i] != second[i]) return false;
+	if (first[1] != 0x51 || first[2] != 0x15) return false;
+	if (first[0] == 1) out->kind = Early;
+	else if (first[0] == 2) out->kind = V2;
+	else return false;
+	out->rev4 = first[0];
+	return true;
+}
+
+/* Explicit byte order from qpnp-fg-gen3; unknown revision fails closed.
+ * Caller handles signed conversion and unit scaling independently. */
+static inline bool decodeWord(Kind kind, uint8_t byte0, uint8_t byte1,
+    uint16_t *out)
+{
+	if (out == 0 || (kind != Early && kind != V2)) return false;
+	*out = kind == Early ? (uint16_t)(((uint16_t)byte0 << 8) | byte1) :
+	    (uint16_t)(((uint16_t)byte1 << 8) | byte0);
+	return true;
+}
+} /* namespace PolarisBatteryRevision */
