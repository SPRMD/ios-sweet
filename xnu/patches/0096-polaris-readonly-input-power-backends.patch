+bool
+spmiInit(void)
+{
+#if defined(POLARIS_DRIVER_HOST_TEST)
+	return true;
+#else
+	if (gSpmiAttempted) {
+		return gSpmiReady;
+	}
+	gSpmiAttempted = true;
+	gSpmiLock = IOLockAlloc();
+	if (gSpmiLock == NULL) {
+		IOLog("POLARIS SPMI: lock allocation failed\\n");
+		return false;
+	}
+	gSpmiCore = ml_io_map(POLARIS_SPMI_CORE_PA, POLARIS_SPMI_CORE_SIZE);
+	gSpmiConfig = ml_io_map(POLARIS_SPMI_CNFG_PA, POLARIS_SPMI_CNFG_SIZE);
+	gSpmiObserver = ml_io_map(POLARIS_SPMI_OBSERVER_PA,
+	    POLARIS_SPMI_OBSERVER_SIZE);
+	if (gSpmiCore == 0 || gSpmiConfig == 0 || gSpmiObserver == 0) {
+		IOLog("POLARIS SPMI: MMIO mapping failed\\n");
+		return false;
+	}
+	uint32_t version = spmiReadMMIO(gSpmiCore, POLARIS_SPMI_VERSION);
+	gSpmiCount = spmiReadMMIO(gSpmiCore, POLARIS_SPMI_FEATURES) & 0x7ffU;
+	if (version < 0x50000000U || version >= 0x70000000U ||
+	    gSpmiCount == 0 || gSpmiCount > POLARIS_SPMI_MAX_CHANNELS) {
+		IOLog("POLARIS SPMI: unsupported arbiter version=%#x channels=%u\\n",
+		    version, gSpmiCount);
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(gSpmiApid) / sizeof(gSpmiApid[0]); ++i) {
+		gSpmiApid[i] = POLARIS_SPMI_NO_APID;
+	}
+	for (unsigned i = 0; i < POLARIS_SPMI_MAX_CHANNELS; ++i) {
+		gSpmiPoisoned[i] = false;
+	}
+	gSpmiReady = true;
+	IOLog("POLARIS SPMI: observer v5 version=%#x channels=%u\\n",
+	    version, gSpmiCount);
+	return true;
+#endif
+}
+
+bool
+spmiRead(uint16_t peripheralId, uint8_t reg, uint8_t *bytes, unsigned count)
+{
+#if defined(POLARIS_DRIVER_HOST_TEST)
+	(void)peripheralId;
+	(void)reg;
+	(void)bytes;
+	(void)count;
+	return false;
+#else
+	if (!gSpmiReady || gSpmiLock == NULL || bytes == NULL || count == 0 ||
+	    count > 8 || peripheralId >= sizeof(gSpmiApid) / sizeof(gSpmiApid[0])) {
+		return false;
+	}
+	IOLockLock(gSpmiLock);
+	uint16_t apid = gSpmiApid[peripheralId];
+	if (apid == POLARIS_SPMI_NO_APID) {
+		apid = spmiFindAPID(peripheralId);
+		gSpmiApid[peripheralId] = apid;
+	}
+	if (apid == POLARIS_SPMI_NO_APID || apid >= POLARIS_SPMI_MAX_CHANNELS ||
+	    gSpmiPoisoned[apid]) {
+		IOLockUnlock(gSpmiLock);
+		return false;
+	}
+	const uint32_t lane = 0x80U * apid;
+	const uint32_t command = POLARIS_SPMI_READ |
+	    ((uint32_t)reg << 4) | (count - 1U);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(gSpmiObserver + lane + POLARIS_SPMI_OBS_COMMAND) = command;
+	__asm__ volatile("dsb osh" ::: "memory");
+	uint32_t status = 0;
+	unsigned waited = 0;
+	for (; waited < POLARIS_SPMI_TIMEOUT_US; ++waited) {
+		status = spmiReadMMIO(gSpmiObserver,
+		    lane + POLARIS_SPMI_OBS_STATUS);
+		if (status & POLARIS_SPMI_DONE) {
+			break;
+		}
+		/* IOSleep(1) would turn this microsecond budget into two seconds.
+		 * The observer transaction is already serialized and bounded; use a
+		 * one-microsecond busy delay so a bad lane cannot stall boot for long. */
+		IODelay(1);
+	}
+	if (!(status & POLARIS_SPMI_DONE) || (status & POLARIS_SPMI_ERROR_MASK)) {
+		if (!(status & POLARIS_SPMI_DONE)) {
+			gSpmiPoisoned[apid] = true;
+			IOLog("POLARIS SPMI: timeout ppid=%#x apid=%u\\n",
+			    peripheralId, apid);
+		}
+		IOLockUnlock(gSpmiLock);
+		return false;
+	}
+	uint32_t data0 = spmiReadMMIO(gSpmiObserver,
+	    lane + POLARIS_SPMI_OBS_DATA0);
+	uint32_t data1 = count > 4 ? spmiReadMMIO(gSpmiObserver,
+	    lane + POLARIS_SPMI_OBS_DATA1) : 0;
+	for (unsigned i = 0; i < count; ++i) {
+		bytes[i] = (uint8_t)((i < 4 ? data0 : data1) >>
+		    (8U * (i & 3U)));
+	}
+	IOLockUnlock(gSpmiLock);
+	return true;
+#endif
+}
+
+bool
+spmiReadByte(uint16_t peripheralId, uint8_t reg, uint8_t *value)
+{
+	return spmiRead(peripheralId, reg, value, 1);
+}
