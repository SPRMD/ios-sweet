+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+PolarisBattery::putNumber(const char *key, long long value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSNumber *number = OSNumber::withNumber((unsigned long long)value, 64);
+	if (symbol != NULL && number != NULL) {
+		setPSProperty(symbol, number);
+	}
+	OSSafeReleaseNULL(number);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+PolarisBattery::publish(unsigned percent, unsigned mv, int ma, int temperature,
+    bool measured, bool currentValid)
+{
+	setBatteryInstalled(true);
+	const unsigned capacity = (kNominalCapacityMah * percent + 50U) / 100U;
+	setCurrentCapacity(capacity);
+	setMaxCapacity(kNominalCapacityMah);
+	setExternalConnected(false);
+	setExternalChargeCapable(false);
+	setIsCharging(false);
+	setAtWarnLevel(false);
+	setAtCriticalLevel(false);
+	setVoltage(mv);
+	setAmperage(ma);
+	setTimeRemaining(-1);
+	setCycleCount(0);
+	putBool("FullyCharged", measured && percent >= 100);
+	putBool("AppleRawExternalConnected", false);
+	putNumber("AppleRawCurrentCapacity", capacity);
+	putNumber("AppleRawMaxCapacity", kNominalCapacityMah);
+	putNumber("NominalChargeCapacity", kNominalCapacityMah);
+	putNumber("DesignCapacity", kNominalCapacityMah);
+	putNumber("InstantAmperage", ma);
+	putNumber("Temperature", temperature);
+	putBool("PolarisBatteryHardwareSampleValid", measured);
+	putBool("PolarisBatteryCurrentValid", currentValid);
+	putBool("PolarisBatteryChargerStatusValid", false);
+	putNumber("PolarisBatteryPercent", percent);
+	updateStatus();
+}
+
+void
+PolarisBattery::poll(void)
+{
+	uint8_t socSubtype = 0, infoSubtype = 0;
+	uint16_t rawSoc = 0, rawVoltage = 0, rawCurrent = 0, rawTemperature = 0;
+	const bool identities =
+	    PolarisDriver::spmiReadByte(kBattSocPeripheral, 0x05, &socSubtype) &&
+	    PolarisDriver::spmiReadByte(kBattInfoPeripheral, 0x05, &infoSubtype) &&
+	    socSubtype == kBattSocSubtype && infoSubtype == kBattInfoSubtype;
+	const bool valid = identities &&
+	    readPair(kBattSocPeripheral, kBattSocMonotonic, &rawSoc) &&
+	    readPair(kBattInfoPeripheral, kBattInfoVoltage, &rawVoltage) &&
+	    readPair(kBattInfoPeripheral, kBattInfoCurrent, &rawCurrent) &&
+	    readPair(kBattInfoPeripheral, kBattInfoTemp, &rawTemperature);
+	if (!valid) {
+		publish(100, 4200, 0, 2500, false, false);
+		return;
+	}
+	unsigned percent = socPercent(rawSoc);
+	if (percent > 100U) {
+		publish(100, 4200, 0, 2500, false, false);
+		return;
+	}
+	const unsigned mv = (unsigned)(((uint64_t)rawVoltage * 122070ULL) / 1000000ULL);
+	int16_t signedRaw = (int16_t)rawCurrent;
+	const int ma = (int)(-((int64_t)signedRaw * 488281LL) / 1000000LL);
+	const unsigned kelvinQuarter =
+	    ((((unsigned)(rawTemperature & 0x07ffU)) + 2U) / 4U);
+	const int temperature = ((int)kelvinQuarter - 273) * 100;
+	if (mv < 2800U || mv > 4600U || temperature < -4000 || temperature > 9000) {
+		publish(100, 4200, 0, 2500, false, false);
+		return;
+	}
+	publish(percent, mv, ma, temperature, true, true);
+}
+
+void
+PolarisBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	PolarisBattery *self = OSDynamicCast(PolarisBattery, owner);
+	if (self != NULL && self->fRunning) {
+		self->poll();
+		sender->setTimeoutMS(30000);
+	}
+}
