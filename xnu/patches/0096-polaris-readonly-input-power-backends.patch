+bool
+PolarisBattery::readPair(uint16_t peripheral, uint8_t reg, uint16_t *value)
+{
+	uint8_t first[2] = {}, second[2] = {};
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		if (!PolarisDriver::spmiRead(peripheral, reg, first, 2)) {
+			return false;
+		}
+		if (!PolarisDriver::spmiRead(peripheral, reg, second, 2)) {
+			return false;
+		}
+		if (first[0] == second[0] && first[1] == second[1]) {
+			*value = (uint16_t)first[0] | ((uint16_t)first[1] << 8);
+			return true;
+		}
+	}
+	return false;
+}
+
+unsigned
+PolarisBattery::socPercent(uint16_t raw)
+{
+	/* The Gen3 driver exposes a shadow byte and rejects mismatched copies. */
+	uint8_t bytes[2] = {(uint8_t)(raw & 0xffU), (uint8_t)(raw >> 8)};
+	if (bytes[0] != bytes[1]) {
+		return 0;
+	}
+	unsigned value = ((unsigned)bytes[0] * 100U + 127U) / 255U;
+	return value > 100U ? 100U : value;
