+/* Qualcomm SPMI PMIC arbiter v5.  The observer window is EE0, which is the
+ * application processor's read-only view.  The only store in this backend is
+ * an EXT_READL command; PMIC configuration and interrupt state are untouched. */
+#define POLARIS_SPMI_CORE_PA       0x0c440000UL
+#define POLARIS_SPMI_CORE_SIZE     0x2000UL
+#define POLARIS_SPMI_CNFG_PA       0x0c40a000UL
+#define POLARIS_SPMI_CNFG_SIZE     0x1000UL
+#define POLARIS_SPMI_OBSERVER_PA   0x0e600000UL
+#define POLARIS_SPMI_OBSERVER_SIZE 0x10000UL
+#define POLARIS_SPMI_VERSION       0x000
+#define POLARIS_SPMI_FEATURES      0x004
+#define POLARIS_SPMI_CHANNEL(n)    (0x900U + 4U * (n))
+#define POLARIS_SPMI_OWNER(n)      (0x700U + 4U * (n))
+#define POLARIS_SPMI_OBS_COMMAND   0x00
+#define POLARIS_SPMI_OBS_STATUS    0x08
+#define POLARIS_SPMI_OBS_DATA0     0x18
+#define POLARIS_SPMI_OBS_DATA1     0x1c
+#define POLARIS_SPMI_READ          (1U << 27)
+#define POLARIS_SPMI_DONE          0x01
+#define POLARIS_SPMI_ERROR_MASK    0x0e
+#define POLARIS_SPMI_MAX_CHANNELS  512U
+#define POLARIS_SPMI_NO_APID       0xffffU
+#define POLARIS_SPMI_TIMEOUT_US    2000U
+
+static vm_offset_t gSpmiCore;
+static vm_offset_t gSpmiConfig;
+static vm_offset_t gSpmiObserver;
+static IOLock *gSpmiLock;
+static uint16_t gSpmiApid[0x1000];
+static bool gSpmiPoisoned[POLARIS_SPMI_MAX_CHANNELS];
+static unsigned gSpmiCount;
+static bool gSpmiAttempted;
+static bool gSpmiReady;
+
+static uint32_t
+spmiReadMMIO(vm_offset_t base, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+spmiFindAPID(uint16_t peripheralId)
+{
+	uint16_t found = POLARIS_SPMI_NO_APID;
+	for (unsigned channel = 0; channel < gSpmiCount; ++channel) {
+		uint32_t mapping = spmiReadMMIO(gSpmiCore,
+		    POLARIS_SPMI_CHANNEL(channel));
+		if (mapping == 0 || ((mapping >> 8) & 0xfffU) != peripheralId) {
+			continue;
+		}
+		uint32_t owner = spmiReadMMIO(gSpmiConfig,
+		    POLARIS_SPMI_OWNER(channel)) & 7U;
+		/* Prefer the channel owned by the application processor. */
+		if (found == POLARIS_SPMI_NO_APID || owner == 0) {
+			found = (uint16_t)channel;
+		}
+	}
+	return found;
+}
