+#if !defined(POLARIS_DRIVER_HOST_TEST)
+static const uint16_t kPONPeripheral = 0x008; /* PM8998 SID0, PON */
+static const uint16_t kGPIO6Peripheral = 0x0c5; /* PM8998 SID0, GPIO6 */
+static const uint8_t kPONStatus = 0x10;
+static const uint8_t kPONPowerMask = 0x80; /* KPDPWR_N */
+static const uint8_t kPONResinMask = 0x40; /* RESIN_N */
+static const uint8_t kGPIOStatus = 0x10;
+static const uint8_t kGPIOMode = 0x40;
+static const uint8_t kGPIOPull = 0x42;
+static const uint8_t kGPIOEnable = 0x46;
+
+bool
+PolarisKeys::configure(void)
+{
+	uint8_t type = 0, subtype = 0;
+	bool ponKnown = PolarisDriver::spmiReadByte(kPONPeripheral, 0x04, &type) &&
+	    PolarisDriver::spmiReadByte(kPONPeripheral, 0x05, &subtype);
+	if (!ponKnown || type != 0x01 || subtype != 0x09) {
+		IOLog("POLARIS KEYS: PON identity rejected type=%#x subtype=%#x\\n",
+		    type, subtype);
+	} else {
+		fPONUsable = true;
+	}
+
+	type = subtype = 0;
+	bool gpioKnown = PolarisDriver::spmiReadByte(kGPIO6Peripheral, 0x04, &type) &&
+	    PolarisDriver::spmiReadByte(kGPIO6Peripheral, 0x05, &subtype);
+	uint8_t mode = 0, pull = 0, enable = 0, level = 0;
+	if (gpioKnown) {
+		gpioKnown = PolarisDriver::spmiReadByte(kGPIO6Peripheral, kGPIOMode, &mode) &&
+		    PolarisDriver::spmiReadByte(kGPIO6Peripheral, kGPIOPull, &pull) &&
+		    PolarisDriver::spmiReadByte(kGPIO6Peripheral, kGPIOEnable, &enable) &&
+		    PolarisDriver::spmiReadByte(kGPIO6Peripheral, kGPIOStatus, &level);
+	}
+	const unsigned direction = mode & 3U;
+	if (!gpioKnown || type != 0x10 || subtype < 0x10 || subtype > 0x13 ||
+	    direction != 0 || (pull & 7U) >= 4 ||
+	    !(enable & 0x80U)) {
+		IOLog("POLARIS KEYS: GPIO6 identity/config rejected type=%#x subtype=%#x "
+		    "mode=%#x pull=%#x enable=%#x\\n", type, subtype, mode, pull, enable);
+	} else {
+		fGPIOUsable = true;
+		fLast[1] = !(level & 1U); /* active-low volume-up */
+	}
+	if (fPONUsable) {
+		uint8_t status = 0;
+		if (!PolarisDriver::spmiReadByte(kPONPeripheral, kPONStatus, &status)) {
+			fPONUsable = false;
+		} else {
+			fLast[0] = (status & kPONPowerMask) != 0;
+			fLast[2] = (status & kPONResinMask) != 0;
+		}
+	}
+	IOLog("POLARIS KEYS: PON=%d GPIO6=%d (read-only)\\n",
+	    fPONUsable, fGPIOUsable);
+	return fPONUsable || fGPIOUsable;
+}
+
+void
+PolarisKeys::report(unsigned key, bool pressed)
+{
+	if (key >= 3 || !((key == 1) ? fGPIOUsable : fPONUsable)) {
+		return;
+	}
+	/* Two consecutive equal samples are required before changing the stable
+	 * state.  This is the same debounce rule for PON and the PMIC GPIO. */
+	if (!fCandidateValid[key] || fCandidate[key] != pressed) {
+		fCandidate[key] = pressed;
+		fCandidateValid[key] = true;
+		return;
+	}
+	if (pressed == fLast[key]) {
+		if (!fLive[key] && !pressed) {
+			fLive[key] = true;
+			IOLog("POLARIS KEYS: key %u released; input trusted\\n", key);
+		}
+		return;
+	}
+	fLast[key] = pressed;
+	if (!fLive[key]) {
+		return;
+	}
+	if (pressed == fDown[key]) {
+		return;
+	}
+	fDown[key] = pressed;
+	IOLog("POLARIS KEYS: key=%u %s\\n", key, pressed ? "down" : "up");
+	sweet_hid_key((int)key, pressed ? 1 : 0);
+}
+
+void
+PolarisKeys::poll(void)
+{
+	uint8_t pon = 0, gpio = 0;
+	const bool ponOK = fPONUsable &&
+	    PolarisDriver::spmiReadByte(kPONPeripheral, kPONStatus, &pon);
+	const bool gpioOK = fGPIOUsable &&
+	    PolarisDriver::spmiReadByte(kGPIO6Peripheral, kGPIOStatus, &gpio);
+	if (ponOK) {
+		report(0, (pon & kPONPowerMask) != 0);
+		report(2, (pon & kPONResinMask) != 0);
+	}
+	if (gpioOK) {
+		report(1, !(gpio & 1U));
+	}
+}
+
+void
+PolarisKeys::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	PolarisKeys *self = OSDynamicCast(PolarisKeys, owner);
+	if (self != NULL && self->fEnabled) {
+		self->poll();
+		sender->setTimeoutMS(16);
+	}
+}
