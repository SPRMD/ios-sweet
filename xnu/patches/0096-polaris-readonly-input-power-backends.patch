+	bool fTimerAdded = false;
+	bool fEnabled = false;
+	bool fPONUsable = false;
+	bool fGPIOUsable = false;
+	bool fLive[3] = {};
+	bool fLast[3] = {};
+	bool fCandidate[3] = {};
+	bool fCandidateValid[3] = {};
+	bool fDown[3] = {};
