diff --git a/iokit/Kernel/arm/PolarisFuelGauge.h b/iokit/Kernel/arm/PolarisFuelGauge.h
--- a/iokit/Kernel/arm/PolarisFuelGauge.h
+++ b/iokit/Kernel/arm/PolarisFuelGauge.h
