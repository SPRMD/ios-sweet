 	*out = value;
 	return true;
 }
+/* Stable paired reads prevent combining bytes sampled across updates. */
+static inline bool readPair(PolarisBatteryRevision::Read read, void *context,
+    uint16_t peripheral, uint8_t reg, uint8_t out[2])
+{
+	uint8_t first[2], second[2];
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		if (!read(context, peripheral, reg, first, 2) ||
+		    !read(context, peripheral, reg, second, 2)) return false;
+		if (first[0] == second[0] && first[1] == second[1]) {
+			out[0] = first[0]; out[1] = first[1]; return true;
+		}
+	}
+	return false;
+}
+
+static inline bool readSample(PolarisBatteryRevision::Read read, void *context,
+    PolarisBatteryRevision::Kind revision, Sample *out)
+{
+	if (!read || !out || (revision != PolarisBatteryRevision::Early &&
+	    revision != PolarisBatteryRevision::V2)) return false;
+	uint8_t socSubtype = 0, infoSubtype = 0;
+	uint8_t soc[2], voltage[2], current[2], temperature[2];
+	if (!read(context, 0x240, 0x05, &socSubtype, 1) ||
+	    !read(context, 0x241, 0x05, &infoSubtype, 1) ||
+	    socSubtype != 0x10 || infoSubtype != 0x11 ||
+	    !readPair(read, context, 0x240, 0x09, soc) ||
+	    !readPair(read, context, 0x241, 0xa0, voltage) ||
+	    !readPair(read, context, 0x241, 0xa2, current) ||
+	    !readPair(read, context, 0x241, 0x50, temperature)) return false;
+	return convert(revision, soc, voltage, current, temperature, out);
+}
 } /* namespace PolarisFuelGauge */
