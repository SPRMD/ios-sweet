diff --git a/iokit/Kernel/arm/PolarisSPMI.h b/iokit/Kernel/arm/PolarisSPMI.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/PolarisSPMI.h
@@ -0,0 +1,36 @@
+/* Bounded, read-only SPMI arbiter-v5 request helpers for Polaris. */
+#pragma once
+#include <stdint.h>
+
+namespace PolarisSPMI {
+static inline unsigned mapCount(unsigned coreSize)
+{
+	if (coreSize <= 0x900U || (coreSize - 0x900U) % 4U != 0) return 0;
+	unsigned count = (coreSize - 0x900U) / 4U;
+	return count <= 512U ? count : 0;
+}
+
+/* Only the specific observer reads used by the keys and fuel-gauge
+ * prototypes are admitted. Extend only with independently checked source. */
+static inline bool permitted(uint16_t peripheral, uint8_t reg, unsigned count)
+{
+	if (count == 0 || count > 8 || (unsigned)reg + count > 256) return false;
+	if (peripheral == 0x008 && count == 1)
+		return reg == 0x04 || reg == 0x05 || reg == 0x10;
+	if (peripheral == 0x0c5 && count == 1)
+		return reg == 0x04 || reg == 0x05 || reg == 0x10 ||
+		    reg == 0x40 || reg == 0x42 || reg == 0x46;
+	if (peripheral == 0x201) return reg == 0x03 && count == 3;
+	if (peripheral == 0x240)
+		return (reg == 0x05 && count == 1) || (reg == 0x09 && count == 2);
+	if (peripheral == 0x241)
+		return (reg == 0x05 && count == 1) ||
+		    (count == 2 && (reg == 0x50 || reg == 0xa0 || reg == 0xa2));
+	return false;
+}
+
+static inline uint32_t readCommand(uint8_t reg, unsigned count)
+{
+	return (1U << 27) | ((uint32_t)reg << 4) | (count - 1U);
+}
+} /* namespace PolarisSPMI */
diff --git a/iokit/Kernel/arm/PolarisFuelGauge.h b/iokit/Kernel/arm/PolarisFuelGauge.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/PolarisFuelGauge.h
@@ -0,0 +1,34 @@
+/* PMI8998 Gen3 raw-to-physical conversions, based on MiCode polaris-o-oss.
+ * No I/O and no iOS charging-state or current-sign interpretation. */
+#pragma once
+#include "PolarisBatteryRevision.h"
+
+namespace PolarisFuelGauge {
+struct Sample {
+	unsigned percent;
+	unsigned millivolts;
+	int currentMicroamps; /* Qualcomm driver convention, not iOS polarity. */
+	int temperatureDeciCelsius;
+};
+
+static inline bool convert(PolarisBatteryRevision::Kind revision,
+    const uint8_t soc[2], const uint8_t voltage[2], const uint8_t current[2],
+    const uint8_t temperature[2], Sample *out)
+{
+	if (!soc || !voltage || !current || !temperature || !out || soc[0] != soc[1])
+		return false;
+	uint16_t v = 0, i = 0;
+	if (!PolarisBatteryRevision::decodeWord(revision, voltage[0], voltage[1], &v) ||
+	    !PolarisBatteryRevision::decodeWord(revision, current[0], current[1], &i))
+		return false;
+	const int signedCurrent = i & 0x8000U ? (int)i - 65536 : (int)i;
+	const unsigned tempRaw = ((unsigned)(temperature[1] & 7U) << 8) | temperature[0];
+	Sample value = {};
+	value.percent = ((unsigned)soc[0] * 100U + 127U) / 255U;
+	value.millivolts = (unsigned)(((uint64_t)v * 122070ULL) / 1000000ULL);
+	value.currentMicroamps = (int)(((int64_t)signedCurrent * 488281LL) / 1000LL);
+	value.temperatureDeciCelsius = ((int)((tempRaw + 2U) / 4U) - 273) * 10;
+	*out = value;
+	return true;
+}
+} /* namespace PolarisFuelGauge */
